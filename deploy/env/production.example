PUBLIC_DOMAIN="app.riskdelta.ai"
NEXT_PUBLIC_APP_URL="https://app.riskdelta.ai"
NEXT_PUBLIC_RISKDELTA_EDITION="community-source-available"
RISKDELTA_EDITION="community-source-available"
RISKDELTA_PREMIUM_MODULE_PATH=""
GHCR_REPOSITORY="ghcr.io/shivanshsguppta/riskdelta-ai"
IMAGE_TAG="latest"
LOG_LEVEL="info"

DATABASE_URL="postgresql://riskdelta:<password>@<managed-postgres-host>:5432/riskdelta?schema=public"
REDIS_URL="redis://default:<password>@<managed-redis-host>:6379"
AUTH_SECRET="replace-with-at-least-32-characters-auth-secret"
ENCRYPTION_KEY="replace-with-at-least-32-characters-secret-key-value"

MINIO_ENDPOINT="s3.amazonaws.com"
MINIO_PORT="443"
MINIO_ACCESS_KEY="replace-with-storage-access-key"
MINIO_SECRET_KEY="replace-with-storage-secret-key"
MINIO_BUCKET="riskdelta-production-evidence"
MINIO_USE_SSL="true"

DEMO_USER_EMAIL="founder@riskdelta.dev"
DEMO_USER_PASSWORD="replace-with-strong-demo-password"

API_RATE_LIMIT_MAX="200"
API_RATE_LIMIT_WINDOW="1 minute"
WORKER_CONCURRENCY="5"
WORKER_HEALTH_PORT="4101"
