{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "AUTH_SECRET",
        "CORS_ALLOWED_ORIGINS",
        "DATABASE_URL",
        "ENCRYPTION_KEY",
        "LOG_LEVEL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_RISKDELTA_EDITION",
        "PUBLIC_DEMO_ENABLED",
        "PUBLIC_DEMO_USER_EMAIL",
        "RISKDELTA_API_URL",
        "RISKDELTA_EDITION",
        "RUNTIME_PROCESSING_MODE",
        "WEB_APP_ORIGIN"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    }
  }
}
